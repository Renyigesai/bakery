{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${displayURL}",
    "sources": "${displayURL}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.renyigesai.bakeries.BakeriesMod"
    ],
    "client": [
      "com.renyigesai.bakeries.BakeriesClientMod",
      "com.renyigesai.bakeries.other.BakeriesClient"
    ],
    "jei_mod_plugin": [
      "com.renyigesai.bakeries.integration.jei.JEIPlugin"
    ]
  },
  "mixins": [
    "bakeries.mixins.json",
    {
      "config": "bakeries_client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "java": ">=17"
  }
}
